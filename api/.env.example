PORT=4000
DATABASE_URL="postgresql://localhost:5432/market?schema=public"
REDIS_URL='redis://localhost:6379'

# `bun setup` fills this in.
JWT_SECRET=

# Leave Paystack pointed at the fake (`bun run --cwd api fake-paystack`), or
# set PAYSTACK_BASE_URL=https://api.paystack.co and use your test keys.
PAYSTACK_BASE_URL=http://localhost:4010
PAYSTACK_SECRET_KEY=sk_test_local_fake
PAYSTACK_WEBHOOK_URL=http://localhost:4000/webhooks/paystack
PAYSTACK_PUBLIC_KEY=

# Without Cloudinary, uploads are written to api/.uploads and served from /files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

LOOPS_API_KEY=

