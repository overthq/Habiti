PORT=4000
DATABASE_URL="postgresql://localhost:5432/market?schema=public"
REDIS_URL='redis://localhost:6379'

JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

LOOPS_API_KEY=

# POSTHOG_API_KEY=

# LOG_LEVEL=trace|debug|info|warn|error|fatal

# Default trace, error, and log backend. Leave unset to disable Sentry.
# SENTRY_DSN=

# OTLP/HTTP base URL (the SDK appends /v1/traces). When set, traces go here
# instead of Sentry, even if SENTRY_DSN is also set. Sentry then stays on
# errors and logs. Grafana, Axiom, Honeycomb, and PostHog's OTLP traces
# endpoint all take this URL. Error grouping stays on Sentry.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Comma-separated key=value list. Percent-encode values that contain commas.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20token

# service.name on exported spans, and the service field on log lines.
# OTEL_SERVICE_NAME=habiti-api

# For CI:
# SENTRY_AUTH_TOKEN=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=''
APPLE_REDIRECT_URI=
