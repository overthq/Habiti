PORT=4000
# Deployed environments set this to production explicitly.
# Leave it unset for local development.
# NODE_ENV=production

DATABASE_URL="postgresql://localhost:5432/market?schema=public"
REDIS_URL='redis://localhost:6379'

JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

LOOPS_API_KEY=

# POSTHOG_API_KEY=

# trace | debug | info | warn | error | fatal (default info).
# trace logs every Prisma query.
# LOG_LEVEL=info

# json | pretty. Optional. When unset, NODE_ENV=production prints JSON and
# every other NODE_ENV (including unset) prints pretty logs.
# LOG_FORMAT=json

# Sentry error reporting. Leave unset to disable.
# SENTRY_DSN=

# For CI:
# SENTRY_AUTH_TOKEN=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=''
APPLE_REDIRECT_URI=
