generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String?  @unique
  appleId      String?  @unique
  isAnonymous  Boolean  @default(false)
  passwordHash String?
  suspended    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]
  managed       StoreManager[]
  followed      StoreFollower[]
  carts         Cart[]
  watchlist     WatchlistProduct[]
  cards         Card[]
  addresses     Address[]
  pushTokens    UserPushToken[]
  ProductReview ProductReview[]
  refreshTokens RefreshToken[]
  sessions      Session[]

  ledgerAccounts LedgerAccount[]
}

model Store {
  id                   String   @id @default(uuid())
  name                 String
  description          String?
  website              String?
  twitter              String?  @db.VarChar(15)
  instagram            String?  @db.VarChar(30)
  unrealizedRevenue    BigInt   @default(0)
  realizedRevenue      BigInt   @default(0)
  paidOut              BigInt   @default(0)
  pendingPayouts       BigInt   @default(0)
  ledgerSequence       BigInt   @default(0)
  orderCount           Int      @default(0)
  unlisted             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  image        Image?
  products     Product[]
  orders       Order[]
  managers     StoreManager[]
  followers    StoreFollower[]
  carts        Cart[]
  transactions Transaction[]
  categories   StoreProductCategory[]
  addresses    Address[]

  ledgerAccounts   LedgerAccount[]
  statementEntries StoreStatementEntry[]
  payoutRequests   PayoutRequest[]
  payoutAccounts   StorePayoutAccount[]
}

model Product {
  id          String             @id @default(uuid())
  name        String
  description String
  unitPrice   Int
  quantity    Int                @default(0)
  storeId     String
  status      ProductStatus      @default(Draft)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  images      Image[]
  orders      OrderProduct[]
  carts       CartProduct[]
  watchlists  WatchlistProduct[]
  categories  ProductCategory[]

  store Store @relation(fields: [storeId], references: [id])

  reviews ProductReview[]
  options ProductOption[]

  @@index([storeId])
  @@index([storeId, status])
  @@index([status])
}

model Order {
  id             String         @id @default(uuid())
  serialNumber   Int
  userId         String
  storeId        String
  status         OrderStatus    @default(Pending)
  transactionFee Int            @default(0)
  serviceFee     Int            @default(0)
  total          Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  products       OrderProduct[]

  user         User          @relation(fields: [userId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  transactions Transaction[]

  ledgerTransactions LedgerTransaction[]
  statementEntries   StoreStatementEntry[]

  @@unique([storeId, serialNumber])
  @@index([userId, createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, status])
}

model OrderProduct {
  orderId   String
  productId String
  unitPrice Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
}

model Cart {
  id        String        @id @default(uuid())
  userId    String?
  storeId   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  CartProduct[]

  @@unique([userId, storeId])
}

model CartProduct {
  cartId    String
  productId String
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

model WatchlistProduct {
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Image {
  id        String   @id @default(uuid())
  storeId   String?  @unique
  productId String?
  path      String   @db.VarChar(2083)
  publicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model StoreManager {
  storeId   String
  managerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  manager   User     @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([storeId, managerId])
  @@index([managerId])
}

model StoreFollower {
  storeId    String
  followerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  follower   User     @relation(fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([storeId, followerId])
  @@index([followerId])
}

model Card {
  id                String   @id @default(uuid())
  userId            String
  email             String
  authorizationCode String
  cardType          String
  last4             String
  expMonth          String
  expYear           String
  bin               String
  bank              String
  signature         String
  countryCode       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, signature])
  @@index([userId])
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  category StoreProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, productId])
  @@index([productId])
}

model StoreProductCategory {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  products ProductCategory[]
}

model ProductReview {
  id        String   @id @default(uuid())
  userId    String
  productId String
  body      String?
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model Address {
  id        String   @id @default(uuid())
  name      String
  line1     String
  line2     String?
  city      String
  state     String
  country   String
  postcode  String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
}

model UserPushToken {
  userId    String
  token     String
  type      PushTokenType @default(Shopper)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
}

model ProductOption {
  id          String   @id @default(uuid())
  productId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id        String   @id @default(uuid())
  optionId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, name])
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens AdminRefreshToken[]
  sessions      AdminSession[]
}

enum ProductStatus {
  Active
  Draft
  Archived
}

enum OrderStatus {
  Pending
  ReadyForPickup
  Cancelled
  Completed
  PaymentPending
}

enum TransactionType {
  Revenue
  Payout
  SubscriptionFee
  Adjustment
  Refund
}

enum TransactionStatus {
  Processing
  Success
  Failure
}

model Transaction {
  id           String            @id @default(uuid())
  storeId      String
  type         TransactionType
  status       TransactionStatus @default(Success)
  amount       Int
  description  String?
  orderId      String?
  balanceAfter Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id])

  @@index([storeId, createdAt])
  @@index([storeId, type])
  @@index([storeId, status])
  @@index([orderId])
}

enum PushTokenType {
  Shopper
  Merchant
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model AdminSession {
  id           String   @id @default(uuid())
  adminId      String
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now())

  admin         Admin               @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokens AdminRefreshToken[]

  @@index([adminId])
}

model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String
  userId      String
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime
  sessionId   String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AdminRefreshToken {
  id          String   @id @default(uuid())
  hashedToken String
  adminId     String
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime
  sessionId   String

  admin   Admin        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  session AdminSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum AccountType {
  Asset
  Liability
  Revenue
  Expense
}

enum AccountKind {
  PlatformCash // Asset     - funds held at Paystack / settled to our bank
  PlatformFeeRevenue // Revenue   - Habiti service fees
  StorePending // Liability - collected, order not yet complete
  StoreAvailable // Liability - complete, withdrawable
  StorePayoutInTransit // Liability - payout requested, not yet settled
  CustomerCredit // Liability - refunds owed to a customer
}

enum EntryDirection {
  Debit
  Credit
}

enum LedgerReason {
  OpeningBalance
  OrderPaid
  OrderCompleted
  OrderCancelledBeforeCompletion
  RefundIssued
  CustomerCreditWithdrawn
  PayoutRequested
  PayoutSettled
  PayoutFailed
  SubscriptionFee
  ManualAdjustment
}

model LedgerAccount {
  id      String      @id @default(uuid())
  kind    AccountKind
  type    AccountType
  storeId String?
  userId  String?

  formerUserId String?
  detachedAt   DateTime?

  createdAt DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Restrict)

  entries LedgerEntry[]

  @@index([storeId])
  @@index([userId])
}

model LedgerTransaction {
  id String @id @default(uuid())

  sequence BigInt @default(autoincrement())

  reason      LedgerReason
  description String?

  idempotencyKey String @unique

  orderId         String?
  payoutRequestId String?
  webhookEventId  String?
  createdAt       DateTime @default(now())

  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payoutRequest PayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: Restrict)
  webhookEvent  WebhookEvent?  @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)

  entries        LedgerEntry[]
  statementEntry StoreStatementEntry?

  @@index([orderId])
  @@index([payoutRequestId])
  @@index([sequence])
}

model LedgerEntry {
  id            String         @id @default(uuid())
  transactionId String
  accountId     String
  direction     EntryDirection
  amount        BigInt

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId, id])
}

model StoreStatementEntry {
  id            String            @id @default(uuid())
  storeId       String
  transactionId String            @unique
  sequence      BigInt
  type          TransactionType
  status        TransactionStatus @default(Success)
  amount        BigInt
  balanceAfter  BigInt
  description   String?
  orderId       String?
  createdAt     DateTime
  updatedAt     DateTime          @updatedAt

  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([storeId, sequence])
  @@index([storeId, type])
  @@index([storeId, createdAt])
  @@index([orderId])
}

enum PayoutStatus {
  Processing
  Settled
  Failed
}

model PayoutRequest {
  id            String       @id @default(uuid())
  storeId       String
  amount        BigInt
  status        PayoutStatus @default(Processing)
  providerRef   String?      @unique
  failureReason String?
  payoutAccountId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  payoutAccount      StorePayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  ledgerTransactions LedgerTransaction[]

  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([payoutAccountId])
}

enum PayoutAccountStatus {
  Active
  Inactive
}

model StorePayoutAccount {
  id       String @id @default(uuid())
  storeId  String
  provider String @default("paystack")

  accountNumber String
  bankCode      String
  accountName   String?
  bankName      String?
  recipientRef  String

  label      String?
  isDefault  Boolean             @default(false)
  status     PayoutAccountStatus @default(Active)
  verifiedAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deactivatedAt DateTime?

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payouts PayoutRequest[]

  @@unique([storeId, provider, recipientRef])
  @@unique([storeId, provider, bankCode, accountNumber])
  @@index([storeId, status])
}

enum WebhookEventStatus {
  Received
  Processed
  Failed
  Skipped
}

model WebhookEvent {
  id          String             @id @default(uuid())
  provider    String
  eventType   String
  externalId  String
  payload     Json
  status      WebhookEventStatus @default(Received)
  attempts    Int                @default(0)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  ledgerTransactions LedgerTransaction[]

  @@unique([provider, externalId])
  @@index([status, receivedAt])
}
