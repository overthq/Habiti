# The e2e stack's settings for every app, committed: nothing here is a secret.
# Put machine-specific overrides (like a DATABASE_URL with your Postgres
# password) in .env.e2e.local, which is gitignored.

E2E_API_PORT=4100
E2E_PAYSTACK_PORT=4110
E2E_WEB_PORT=3100
E2E_ADMIN_PORT=3101
E2E_METRO_PORT=8182
E2E_CODES_PORT=4120

# API and fake Paystack
PORT=${E2E_API_PORT}
PUBLIC_URL=http://localhost:${E2E_API_PORT}
DATABASE_URL=postgresql://localhost:5432/habiti_e2e?schema=public
REDIS_URL=redis://localhost:6379/1
JWT_SECRET=e2e-jwt-secret-not-for-production
PAYSTACK_SECRET_KEY=sk_test_e2e_fake
PAYSTACK_BASE_URL=http://localhost:${E2E_PAYSTACK_PORT}
FAKE_PAYSTACK_PORT=${E2E_PAYSTACK_PORT}
PAYSTACK_WEBHOOK_URL=http://localhost:${E2E_API_PORT}/webhooks/paystack
RATE_LIMIT_DISABLED=true
PUSH_OUTBOX_KEY=e2e:outbox
LOG_LEVEL=info

# Web, admin and dashboard
VITE_API_URL=http://localhost:${E2E_API_PORT}
VITE_PAYSTACK_HOSTED_CHECKOUT=true
# Frees the worker debugger ports, so the dev stack can run alongside
WORKER_INSPECTOR=off
EXPO_PUBLIC_API_URL=http://localhost:${E2E_API_PORT}
