# Uncomment to override. Left unset, the API URL is the Metro host's :4000
# (works on simulators and devices on the same network), and
# `bun run start:e2e` points the app at the e2e API.
# An empty value here would override those, so keep unused lines commented.
# EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_WEB_FRONTEND_URL=
# EXPO_PUBLIC_SENTRY_DSN=
